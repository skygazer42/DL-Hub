root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2
# Preserve intentional Markdown hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# These historical MATLAB sources contain GBK comments. Preserve their bytes
# until an explicit, separately reviewed encoding migration is undertaken.
[optimization/ACO/ACO_TSO/{DrawRoute.m,main.m}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[optimization/AHP/ahp_common.m]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[optimization/GA/{Variation.m,crossover.m,m_Coding.m,m_Fitness.m,m_Fun.m,m_Incoding.m,m_Select.m,main.m}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Binary assets and model artifacts must never receive text-editor rewrites.
[*.{png,jpg,jpeg,gif,webp,ico,pdf,eps,gz,tgz,tar,zip,7z,pt,pth,ckpt,onnx,safetensors,npy,npz,pkl,pickle}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
